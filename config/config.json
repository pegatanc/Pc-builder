{
  "$comment": "Tracker configuration. Target prices live under `targets` (keyed by part id from parts.json).",
  "currency": "USD",
  "baselineTotal": 1315,
  "schedule": {
    "cron": "0 */12 * * *",
    "timezone": "America/New_York",
    "runOnStart": true
  },
  "alerts": {
    "dropPercent": 10,
    "windowDays": 30,
    "minSamples": 3
  },
  "alternatives": {
    "enabled": true,
    "perPart": 5,
    "refreshDays": 7,
    "minRating": 4.0,
    "minReviews": 50,
    "priceBand": [
      0.4,
      2.5
    ]
  },
  "sources": {
    "order": [
      "canopy",
      "paapi",
      "keepa",
      "bestbuy",
      "jsonld",
      "browser",
      "manual",
      "sample"
    ],
    "enabled": {
      "canopy": true,
      "paapi": true,
      "keepa": true,
      "bestbuy": false,
      "jsonld": false,
      "browser": false,
      "manual": true,
      "sample": true
    },
    "http": {
      "userAgent": "pc-builder-price-tracker/1.0 (self-hosted; +http://localhost)",
      "minDelayMsPerHost": 5000,
      "timeoutMs": 15000,
      "maxRetries": 2
    },
    "amazonDomain": "www.amazon.com"
  },
  "targets": {
    "cpu-ryzen-7-5700x": 150,
    "mobo-msi-b550-tomahawk": 160,
    "ram-ddr4-3600-cl16-32gb": 75,
    "ssd-sk-hynix-p41-1tb": 80,
    "psu-750w-gold-modular": 90,
    "gpu-asrock-rx-7900-xt": 620,
    "cooler-hyper-212-black": 35,
    "case-nzxt-h6-flow": 95,
    "fan-arctic-p12": 8
  }
}
