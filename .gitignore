node_modules/
site/

# The database itself is disposable, but the NDJSON history is the record the
# Pages workflow carries between runs — keep that one file tracked.
data/*
!data/price-history.ndjson

*.db
*.db-shm
*.db-wal
.env
# NOT ignored: the Pages workflow runs on a fresh checkout, so hand-entered
# prices must be committed for CI to see them. It holds prices, not secrets.
.DS_Store
npm-debug.log*
