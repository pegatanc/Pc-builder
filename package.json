{
  "name": "pc-builder-price-tracker",
  "version": "1.0.0",
  "description": "Self-hosted price tracker for a PC parts build. Node + SQLite + vanilla frontend.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "seed": "node --import ./src/lib/fatal.js src/seed.js",
    "fetch": "node src/fetch-once.js",
    "sources": "node src/fetch-once.js --list",
    "test": "node --test test/*.test.js",
    "site": "node src/export-static.js",
    "history:import": "node --import ./src/lib/fatal.js src/history.js import",
    "history:export": "node --import ./src/lib/fatal.js src/history.js export",
    "price": "node src/set-price.js",
    "owner-key": "node src/set-owner-key.js",
    "alternatives": "node src/refresh-alternatives.js",
    "ebay:probe": "node src/probe-ebay.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "node-cron": "^3.0.3"
  },
  "license": "MIT",
  "private": true
}
