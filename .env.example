# Copy to .env and load it however you like (e.g. `node --env-file=.env src/server.js`).
# Every source is optional — with none of these set the app runs on sample data.

# --- Amazon: Canopy API (paid REST, no affiliate account needed)
# CANOPY_API_KEY=

# --- Amazon: official Product Advertising API v5 (needs an approved Associates account)
# PAAPI_ACCESS_KEY=
# PAAPI_SECRET_KEY=
# PAAPI_PARTNER_TAG=yourtag-20
# PAAPI_HOST=webservices.amazon.com
# PAAPI_REGION=us-east-1
# PAAPI_MARKETPLACE=www.amazon.com

# --- Amazon: Keepa (paid, no affiliate account required)
# KEEPA_API_KEY=
# KEEPA_DOMAIN=1        # 1 = amazon.com, 2 = .co.uk, 3 = .de ...

# --- Best Buy (free key at developer.bestbuy.com)
# BESTBUY_API_KEY=

# --- Server
# PORT=3000
# HOST=127.0.0.1
